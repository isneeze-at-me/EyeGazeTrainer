<Page x:Class="EyeGazeApiViability.LevelOnePreview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#101827">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="28,22,28,12" Spacing="10">
      <TextBlock Text="Eye gaze — startup and shutdown diagnostic" FontSize="30" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="LIVE GAZE EXPERIMENTAL. Use with a helper and independent keyboard/mouse access. Prefer the dedicated EXIT button over the window X."
                 TextWrapping="Wrap" FontSize="18" Foreground="#FCA5A5"/>
      <TextBlock x:Name="InstructionText"
                 Text="Confirm gaze tracking, then use EXIT APP to run staged cleanup and navigate away before closing."
                 FontSize="23" TextWrapping="Wrap" Foreground="#E2E8F0"/>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="LiveButton" Content="RESTART LIVE GAZE (HELPER)" Click="OnEnableLive" Padding="16,12" FontSize="17"/>
        <Button x:Name="StopButton" Content="STOP GAZE — 1.5s LOOK" Click="OnStopLive" Padding="16,12" FontSize="17" IsEnabled="False"/>
        <Button x:Name="ExitButton" Content="EXIT APP — 1.5s LOOK" Click="OnExitRequested" Padding="16,12" FontSize="17"/>
      </StackPanel>
      <TextBlock x:Name="LiveStatusText" Text="Starting tracker on app launch (supervised test)" TextWrapping="Wrap" FontSize="17" Foreground="#FBBF24"/>
      <TextBlock x:Name="ProgressText" Text="Discover the moving circle" FontSize="18" Foreground="#93C5FD"/>
    </StackPanel>
    <Canvas Grid.Row="1" x:Name="TrainingCanvas" Margin="24" Background="#17253D"
            PointerMoved="OnPointerMoved" PointerEntered="OnPointerMoved" SizeChanged="OnCanvasSized">
      <Ellipse x:Name="TargetRing" Width="116" Height="116"
               Stroke="#FBBF24" StrokeThickness="8" Fill="#344358" Visibility="Collapsed"/>
      <Ellipse x:Name="PreviewDot" Width="44" Height="44" Fill="#34D399" Visibility="Collapsed"/>
    </Canvas>
    <Grid Grid.Row="2" Margin="28,10,28,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Gaze-only Stop and Exit: look for 1.5 seconds • No TD Control click needed" FontSize="17"
                 Foreground="#CBD5E1" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button x:Name="BackButton" Grid.Column="1" Content="BACK TO DIAGNOSTICS (developer)"
              Click="OnBack" FontSize="18" Padding="16,12"/>
    </Grid>
  </Grid>
</Page>
