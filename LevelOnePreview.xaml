<Page x:Class="EyeGazeApiViability.LevelOnePreview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="RootLayout" Background="#101827">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="28,22,28,12" Spacing="10">
      <TextBlock Text="EyeGazeTrainer" FontSize="30" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="Look at each circle and hold your gaze briefly. Use the large Exit button to return to your computer."
                 TextWrapping="Wrap" FontSize="18" Foreground="#FCA5A5"/>
      <TextBlock x:Name="InstructionText"
                 Text="Look at each yellow target and hold for half a second."
                 FontSize="23" TextWrapping="Wrap" Foreground="#E2E8F0"/>
      <Button x:Name="ExitButton" Content="EXIT"
              Click="OnExitRequested" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" MinHeight="96"
              Padding="24,22" FontSize="27" FontWeight="Bold"/>
      <TextBlock x:Name="LiveStatusText" Text="Connecting to eye tracker…" TextWrapping="Wrap" FontSize="17" Foreground="#FBBF24"/>
      <TextBlock x:Name="ProgressText" Text="Look at the colored circles to begin" FontSize="18" Foreground="#93C5FD"/>
      <TextBlock x:Name="AccuracyText" Text="Training score: getting started" FontSize="18" Foreground="#86EFAC"/>
    </StackPanel>
    <Canvas Grid.Row="1" x:Name="TrainingCanvas" Margin="24" Background="#17253D"
            PointerMoved="OnPointerMoved" PointerEntered="OnPointerMoved" SizeChanged="OnCanvasSized">
      <Ellipse x:Name="TargetRing" Width="116" Height="116"
               Stroke="#FBBF24" StrokeThickness="8" Fill="#344358" Visibility="Collapsed"/>
    </Canvas>
    <TextBlock Grid.Row="2" Margin="28,12,28,22"
               Text="To exit, look at EXIT for 1.5 seconds."
               TextWrapping="Wrap" FontSize="18" Foreground="#CBD5E1"/>
    <!-- Overlay spans all content rows, including Exit; never captures clicks. -->
    <Canvas x:Name="CursorOverlay" Grid.RowSpan="3" IsHitTestVisible="False"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Canvas.ZIndex="10">
      <Ellipse x:Name="PreviewDot" Width="44" Height="44" Fill="#34D399"
               Visibility="Collapsed" IsHitTestVisible="False"/>
    </Canvas>
  </Grid>
</Page>
