<!-- ============================================================================
     EyeGazeTrainer
     File: LevelOnePreview.xaml
     Purpose: Declares the single training page, shared button styles, screen panels and noninteractive overlays.
     ============================================================================ -->
<Page x:Class="EyeGazeApiViability.LevelOnePreview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared accessible control styles === -->
  <Page.Resources>
    <!-- Accessible high-contrast button palette. Keep native UWP focus,
         pointer, and click semantics for eye-gaze hit testing. -->
    <Style x:Key="PrimaryGazeButton" TargetType="Button">
      <Setter Property="Background" Value="#265B96"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#76B9F3"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="24,16"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SecondaryGazeButton" TargetType="Button">
      <Setter Property="Background" Value="#293A53"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#7187A5"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22,14"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DangerGazeButton" TargetType="Button">
      <Setter Property="Background" Value="#713A47"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#EAA0AE"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22,14"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PendingLevelButton" TargetType="Button">
      <Setter Property="Background" Value="#26354B"/>
      <Setter Property="Foreground" Value="#E4ECF8"/>
      <Setter Property="BorderBrush" Value="#566D8A"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ReportLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="Foreground" Value="#E7F1FF"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ReportValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style x:Key="ReportTrendStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#CBD5E1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="MinWidth" Value="30"/>
    </Style>
  </Page.Resources>
  <Grid x:Name="RootLayout" Background="#101827">
    <!-- Single gaze-owning Page: screen changes never release the eye tracker. -->
    <!-- First-run gaze-only introduction: no instructional text. -->
    <Grid x:Name="LevelZeroPanel" Background="#080F1C"
          Visibility="Collapsed">
      <Canvas x:Name="LevelZeroCanvas" Background="#080F1C"
              IsHitTestVisible="False">
        <Ellipse x:Name="LevelZeroPursuitTarget" Width="220" Height="220"
                 Stroke="#6FC9F9" StrokeThickness="8" Fill="#203E5B"
                 Visibility="Collapsed"/>
        <Ellipse x:Name="LevelZeroPursuitCenter" Width="18" Height="18"
                 Fill="#C7F0FF" Visibility="Collapsed"/>
      </Canvas>
      <!-- Visual-only Level 0 movement examples. They never take input
           or participate in eye-gaze movement scoring. -->
      <Grid x:Name="LevelZeroMovementGuide" Visibility="Collapsed"
            IsHitTestVisible="False" HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch" Margin="70,56">
          <Canvas Width="900" Height="600">
            <Canvas x:Name="LevelZeroVerticalGuide" Visibility="Collapsed">
              <Line X1="450" Y1="92" X2="450" Y2="508"
                    Stroke="#66DCEFFF" StrokeThickness="14"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Polyline Points="404,140 450,88 496,140"
                        Stroke="#B5F3FF" StrokeThickness="14"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" Fill="Transparent"/>
              <Polyline Points="404,460 450,512 496,460"
                        Stroke="#B5F3FF" StrokeThickness="14"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" Fill="Transparent"/>
            </Canvas>
            <Canvas x:Name="LevelZeroHorizontalGuide" Visibility="Collapsed">
              <Line X1="115" Y1="300" X2="785" Y2="300"
                    Stroke="#66DCEFFF" StrokeThickness="14"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Polyline Points="168,252 110,300 168,348"
                        Stroke="#B5F3FF" StrokeThickness="14"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" Fill="Transparent"/>
              <Polyline Points="732,252 790,300 732,348"
                        Stroke="#B5F3FF" StrokeThickness="14"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" Fill="Transparent"/>
            </Canvas>
            <!-- Top-left ↔ bottom-right and bottom-left ↔ top-right.
                 Decorative only; practice is judged from gaze displacement. -->
            <Canvas x:Name="LevelZeroDiagonalDownGuide" Visibility="Collapsed">
              <Line X1="225" Y1="75" X2="675" Y2="525"
                    Stroke="#66DCEFFF" StrokeThickness="14"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Polyline Points="225,147 225,75 297,75"
                        Stroke="#B5F3FF" StrokeThickness="14"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" Fill="Transparent"/>
              <Polyline Points="603,525 675,525 675,453"
                        Stroke="#B5F3FF" StrokeThickness="14"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" Fill="Transparent"/>
            </Canvas>
            <Canvas x:Name="LevelZeroDiagonalUpGuide" Visibility="Collapsed">
              <Line X1="225" Y1="525" X2="675" Y2="75"
                    Stroke="#66DCEFFF" StrokeThickness="14"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Polyline Points="225,453 225,525 297,525"
                        Stroke="#B5F3FF" StrokeThickness="14"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" Fill="Transparent"/>
              <Polyline Points="603,75 675,75 675,147"
                        Stroke="#B5F3FF" StrokeThickness="14"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" Fill="Transparent"/>
            </Canvas>
            <Canvas x:Name="LevelZeroCircleGuide" Visibility="Collapsed">
              <Ellipse Canvas.Left="200" Canvas.Top="50"
                       Width="500" Height="500" Stroke="#66DCEFFF"
                       StrokeThickness="14" Fill="Transparent"/>
            </Canvas>
          </Canvas>
        </Viewbox>
      </Grid>
      <!-- Spoken exercise directions are displayed instead of the movement
           guide until narration has completed. Noninteractive by design. -->
      <Grid x:Name="LevelZeroInstructionPanel" Visibility="Collapsed"
            Background="Black" IsHitTestVisible="False">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="28">
          <StackPanel Width="1050" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
          <TextBlock Text="EYE GAZE PRACTICE"
                     Foreground="#FFD84D" FontFamily="Comic Sans MS" FontSize="72" FontWeight="Bold"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock x:Name="LevelZeroInstructionText" Text=""
                     Foreground="#69E6FF" FontFamily="Comic Sans MS" FontSize="42" FontWeight="Bold"
                     TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Viewbox>
      </Grid>
      <Button x:Name="LevelZeroContinueButton"
              Style="{StaticResource PrimaryGazeButton}"
              Content="⌂" FontSize="88" FontWeight="Bold"
              Width="330" Height="210"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="36,36,0,0"
              Visibility="Collapsed"
              AutomationProperties.Name="Home button"
              Click="OnLevelZeroContinue"/>
      <!-- Noninteractive, fully automatic celebration after Home is selected.
           No additional dwell/click skill is required to continue. -->
      <Grid x:Name="LevelZeroCompletionPanel" Visibility="Collapsed"
            Background="Black" IsHitTestVisible="False">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="28">
          <StackPanel Width="1050" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
          <TextBlock Text="INTRODUCTION COMPLETE!"
                     Foreground="#FFD84D" FontFamily="Comic Sans MS" FontSize="76" FontWeight="Bold"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="Congratulations on completing your introduction!"
                     Foreground="#69E6FF" FontFamily="Comic Sans MS" FontSize="48" FontWeight="Bold"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="You have six more lessons to continue your eye-gaze training."
                     Foreground="#69E6FF" FontFamily="Comic Sans MS" FontSize="42" FontWeight="Bold"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="Replay any level as often as you like, because practice makes perfect!"
                     Foreground="#69E6FF" FontFamily="Comic Sans MS" FontSize="42" FontWeight="Bold"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="Opening the Level Menu automatically…"
                     Foreground="#69E6FF" FontFamily="Comic Sans MS" FontSize="30" FontWeight="Bold"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Viewbox>
      </Grid>
      <!-- Speech plays through a nonvisual Windows MediaPlayer instance. -->
    </Grid>

    <!-- Main menu === -->
    <Grid x:Name="HomePanel" Background="#101827" Padding="26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Spacing="6" Margin="0,2,0,14">
        <TextBlock Text="Eye Gaze Trainer" FontSize="36" FontWeight="Bold"
                   TextAlignment="Center" Foreground="White"/>
        <!-- Keep the named accuracy value available to diagnostics logic,
             but do not display it on the main menu. -->
        <TextBlock x:Name="AccuracyText" Text="ACCURACY —"
                   Visibility="Collapsed" IsHitTestVisible="False"
                   FontSize="25" FontWeight="SemiBold" TextAlignment="Center"
                   TextWrapping="Wrap" Foreground="#86EFAC"/>
        <!-- Diagnostic status is available to the app but not shown as
             extra data on the uncluttered main menu. -->
        <TextBlock x:Name="LiveStatusText" Text="Connecting to eye tracker…"
                   Visibility="Collapsed" TextAlignment="Center"
                   TextWrapping="Wrap" FontSize="16"
                   Foreground="#FBBF24"/>
      </StackPanel>
      <!-- Four training and utility actions in a 2x2 grid,
           with a separate full-width Exit action beneath. -->
      <Grid Grid.Row="1" RowSpacing="18">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <!-- Reserve a fixed 200-pixel row so the EXIT control itself
               visibly doubles in height, not just its minimum-size hint. -->
          <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource PrimaryGazeButton}" x:Name="LevelsMenuButton"
                Grid.Row="0" Grid.Column="0" Content="EYE GAZE TRAINER" Click="OnOpenLevels"
                FontSize="30" FontWeight="Bold" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                MinHeight="110" Margin="0,0,9,0"/>
        <Button Style="{StaticResource SecondaryGazeButton}" x:Name="TdControlMenuButton"
                Grid.Row="0" Grid.Column="1" Content="TD CONTROL TRAINER" Click="OnTdControlTrainer"
                FontSize="30" FontWeight="Bold" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                MinHeight="110" Margin="9,0,0,0"/>
        <Button Style="{StaticResource PrimaryGazeButton}" x:Name="DiagnosticsMenuButton"
                Grid.Row="1" Grid.Column="0" Content="DIAGNOSTICS" Click="OnOpenDiagnostics"
                FontSize="30" FontWeight="Bold" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                MinHeight="110" Margin="0,0,9,0"/>
        <Button Style="{StaticResource SecondaryGazeButton}" x:Name="SettingsMenuButton"
                Grid.Row="1" Grid.Column="1" Content="SETTINGS" Click="OnDisplaySettingsRequested"
                FontSize="30" FontWeight="Bold" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                MinHeight="110" Margin="9,0,0,0"/>
        <Button Style="{StaticResource DangerGazeButton}" x:Name="ExitButton"
                Grid.Row="2" Grid.ColumnSpan="2" Content="EXIT" Click="OnExitRequested"
                FontSize="30" FontWeight="Bold" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                Height="200" MinHeight="200"/>
      </Grid>
      <TextBlock x:Name="HomeNoticeText" Grid.Row="2" FontSize="18"
                 TextAlignment="Center" Foreground="#FBBF24"
                 TextWrapping="Wrap"/>
    </Grid>

    <!-- One persistent gaze-owning Diagnostics page; tabs only toggle
         child panels and never create a second gaze input device. -->
    <!-- Diagnostic tabs === -->
    <Grid x:Name="DiagnosticsPanel" Background="Black" Visibility="Collapsed" Padding="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="104"/>
        <RowDefinition Height="92"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <TextBlock Text="DIAGNOSTICS" FontSize="36" FontWeight="Bold"
                   Foreground="White" TextAlignment="Center"
                   VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Button Style="{StaticResource DangerGazeButton}" x:Name="DiagnosticsBackButton"
                Content="BACK" Click="OnBackToMenu" MinHeight="86" MinWidth="155"
                Padding="16,12" FontSize="22" FontWeight="Bold"
                HorizontalAlignment="Left" VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="1" ColumnSpacing="14" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="DiagnosticsOverviewTabButton" Grid.Column="0" Content="OVERVIEW"
                Style="{StaticResource PrimaryGazeButton}" Click="OnDiagnosticsTabClicked"
                FontSize="23" FontWeight="Bold" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalAlignment="Stretch"/>
        <Button x:Name="DiagnosticsSkillsTabButton" Grid.Column="1" Content="SKILLS"
                Style="{StaticResource SecondaryGazeButton}" Click="OnDiagnosticsTabClicked"
                FontSize="23" FontWeight="Bold" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalAlignment="Stretch"/>
        <Button x:Name="DiagnosticsMapsTabButton" Grid.Column="2" Content="MAPS"
                Style="{StaticResource SecondaryGazeButton}" Click="OnDiagnosticsTabClicked"
                FontSize="23" FontWeight="Bold" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalAlignment="Stretch"/>
        <Button x:Name="DiagnosticsSessionsTabButton" Grid.Column="3" Content="SESSIONS"
                Style="{StaticResource SecondaryGazeButton}" Click="OnDiagnosticsTabClicked"
                FontSize="23" FontWeight="Bold" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalAlignment="Stretch"/>
      </Grid>

      <!-- Overview: lifetime report. Trend history is separate from session history. -->
      <Grid x:Name="DiagnosticsOverviewPanel" Grid.Row="2" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Background="#214E83"
                BorderBrush="#76B9F3" BorderThickness="2" CornerRadius="12">
          <Grid Padding="18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="TRAINING REPORT" FontSize="26" FontWeight="Bold"
                       Foreground="White" TextAlignment="Center" Margin="0,0,0,12"/>
            <Grid Grid.Row="1" ColumnSpacing="10" RowSpacing="7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Levels completed" Style="{StaticResource ReportLabelStyle}"/>
              <TextBlock x:Name="ReportLevelsText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ReportValueStyle}"/>
              <TextBlock Grid.Row="1" Text="Completed runs" Style="{StaticResource ReportLabelStyle}"/>
              <TextBlock x:Name="ReportRunsText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ReportValueStyle}"/>
              <TextBlock Grid.Row="2" Text="Practice time" Style="{StaticResource ReportLabelStyle}"/>
              <TextBlock x:Name="ReportHoursText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ReportValueStyle}"/>
              <TextBlock Grid.Row="3" Text="Overall accuracy" Style="{StaticResource ReportLabelStyle}"/>
              <TextBlock x:Name="ReportOverallText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ReportValueStyle}"/>
              <TextBlock x:Name="ReportOverallTrend" Grid.Row="3" Grid.Column="2" Style="{StaticResource ReportTrendStyle}"/>
              <TextBlock Grid.Row="4" Text="Target accuracy" Style="{StaticResource ReportLabelStyle}"/>
              <TextBlock x:Name="ReportAccuracyText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ReportValueStyle}"/>
              <TextBlock x:Name="ReportAccuracyTrend" Grid.Row="4" Grid.Column="2" Style="{StaticResource ReportTrendStyle}"/>
              <TextBlock Grid.Row="5" Text="Eye jitter" Style="{StaticResource ReportLabelStyle}"/>
              <TextBlock x:Name="ReportJitterText" Grid.Row="5" Grid.Column="1" Style="{StaticResource ReportValueStyle}"/>
              <TextBlock x:Name="ReportJitterTrend" Grid.Row="5" Grid.Column="2" Style="{StaticResource ReportTrendStyle}"/>
              <TextBlock Grid.Row="6" Text="Smoothing filter" Style="{StaticResource ReportLabelStyle}"/>
              <TextBlock x:Name="ReportSmoothingText" Grid.Row="6" Grid.Column="1" Style="{StaticResource ReportValueStyle}"/>
              <TextBlock x:Name="ReportSmoothingTrend" Grid.Row="6" Grid.Column="2" Style="{StaticResource ReportTrendStyle}"/>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#182B43" BorderBrush="#566D8A"
                BorderThickness="2" CornerRadius="12" Padding="24">
          <StackPanel Spacing="18" VerticalAlignment="Center">
            <TextBlock Text="YOUR PROGRESS" Foreground="White" FontSize="26"
                       FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="SUGGESTED DWELL TIME" Foreground="#9CE4F8" FontSize="21" FontWeight="Bold" TextAlignment="Center"/>
             <TextBlock x:Name="RecommendedDwellText" Text="1500 ms" Foreground="White" FontSize="32" FontWeight="Bold" TextAlignment="Center"/>
             <TextBlock x:Name="RecommendedDwellEvidenceText" Text="Starting estimate; awaiting practice" Foreground="#D4E6F8" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"/>
             <TextBlock Text="Provisional recommendation; does not change active dwell timers." Foreground="#D4E6F8" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"/>
             <TextBlock Text="▲ Improving    ▼ Declining    — Stable / awaiting history"
                       Foreground="#D4E6F8" FontSize="19" TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock Text="Performance trends compare recent practice results. Changes in tracking, positioning, fatigue, or task difficulty can affect the scores."
                       Foreground="#D4E6F8" FontSize="20" TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock Text="Choose SKILLS for assessment measures, MAPS for screen locations, or SESSIONS for session history."
                       Foreground="#9CE4F8" FontSize="19" TextWrapping="Wrap"
                       TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Skills: six skill categories, one for each of Levels 1-6.
           Every new measurement is NA until a validated recorder exists. -->
      <Grid x:Name="DiagnosticsSkillsPanel" Grid.Row="2" Visibility="Collapsed"
            RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="84"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,2">
          <TextBlock Text="SKILL MEASUREMENTS" FontSize="25"
                     FontWeight="Bold" TextAlignment="Center" Foreground="White"
                     VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="SkillsIntroButton" Grid.Column="0" Content="TARGETS"
                  Style="{StaticResource PrimaryGazeButton}" Click="OnSkillsCategoryClicked"
                  FontSize="19" FontWeight="Bold" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button x:Name="SkillsTargetsButton" Grid.Column="1" Content="DWELL"
                  Style="{StaticResource SecondaryGazeButton}" Click="OnSkillsCategoryClicked"
                  FontSize="19" FontWeight="Bold" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button x:Name="SkillsDwellButton" Grid.Column="2" Content="TRACKING"
                  Style="{StaticResource SecondaryGazeButton}" Click="OnSkillsCategoryClicked"
                  FontSize="19" FontWeight="Bold" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button x:Name="SkillsTrackingButton" Grid.Column="3" Content="ENDURANCE"
                  Style="{StaticResource SecondaryGazeButton}" Click="OnSkillsCategoryClicked"
                  FontSize="19" FontWeight="Bold" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button x:Name="SkillsEnduranceButton" Grid.Column="4" Content="FUNCTION"
                  Style="{StaticResource SecondaryGazeButton}" Click="OnSkillsCategoryClicked"
                  FontSize="19" FontWeight="Bold" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button x:Name="SkillsFunctionButton" Grid.Column="5" Content="NAVIGATION"
                  Style="{StaticResource SecondaryGazeButton}" Click="OnSkillsCategoryClicked"
                  FontSize="19" FontWeight="Bold" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </Grid>
        <Grid x:Name="SkillsMetricsGrid" Grid.Row="2"
              ColumnSpacing="12" RowSpacing="12"/>
      </Grid>

      <!-- Compare two location maps without shrinking them into quarter-size cards. -->
      <Grid x:Name="DiagnosticsMapsPanel" Grid.Row="2" Visibility="Collapsed"
            ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Background="#214E83"
                BorderBrush="#76B9F3" BorderThickness="2" CornerRadius="12">
          <Grid Padding="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="ACCURACY" FontSize="26" FontWeight="Bold"
                       TextAlignment="Center" Foreground="White" Margin="0,0,0,8"/>
            <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center"
                     VerticalAlignment="Center">
              <Grid Width="620" Height="390">
                <Polygon Points="555,66 610,105 598,349 547,340"
                         Fill="#475569" Stroke="#8FA6BF" StrokeThickness="3"
                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border Width="584" Height="376" CornerRadius="16"
                        BorderBrush="#94A3B8" BorderThickness="4"
                        Background="#121A26" HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                  <Grid>
                    <Border Margin="19,18,19,24" Background="Black"
                            BorderBrush="#334155" BorderThickness="2">
                      <Grid x:Name="AccuracyHeatmapGrid" Background="Black" Margin="3"/>
                    </Border>
                    <Ellipse Width="7" Height="7" Fill="#64748B"
                             VerticalAlignment="Bottom" HorizontalAlignment="Center"
                             Margin="0,0,0,9"/>
                  </Grid>
                </Border>
              </Grid>
            </Viewbox>
            <TextBlock Grid.Row="2" Text="Higher % = better · Green 80+ · Yellow 60–79 · Red 0–59" FontSize="15"
                       Foreground="#EFF6FF" TextAlignment="Center" Margin="0,5,0,0"/>
          </Grid>
        </Border>

                <Border Grid.Row="0" Grid.Column="1" Background="#214E83"
                BorderBrush="#76B9F3" BorderThickness="2" CornerRadius="12">
          <Grid Padding="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="EYE JITTER" FontSize="26" FontWeight="Bold"
                       TextAlignment="Center" Foreground="White" Margin="0,0,0,8"/>
            <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center"
                     VerticalAlignment="Center">
              <Grid Width="620" Height="390">
                <Polygon Points="555,66 610,105 598,349 547,340"
                         Fill="#475569" Stroke="#8FA6BF" StrokeThickness="3"
                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border Width="584" Height="376" CornerRadius="16"
                        BorderBrush="#94A3B8" BorderThickness="4"
                        Background="#121A26" HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                  <Grid>
                    <Border Margin="19,18,19,24" Background="Black"
                            BorderBrush="#334155" BorderThickness="2">
                      <Grid x:Name="JitterHeatmapGrid" Background="Black" Margin="3"/>
                    </Border>
                    <Ellipse Width="7" Height="7" Fill="#64748B"
                             VerticalAlignment="Bottom" HorizontalAlignment="Center"
                             Margin="0,0,0,9"/>
                  </Grid>
                </Border>
              </Grid>
            </Viewbox>
            <TextBlock Grid.Row="2" Text="Lower mm = steadier · Green ≤2 · Yellow ≤4 · Red &gt;4" FontSize="15"
                       Foreground="#EFF6FF" TextAlignment="Center" Margin="0,5,0,0"/>
          </Grid>
        </Border>

      </Grid>

      <!-- Persisted session history and report export === -->
      <Grid x:Name="DiagnosticsSessionsPanel" Grid.Row="2"
            Visibility="Collapsed" RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="SESSION HISTORY &amp; REPORTS"
                   FontSize="26" FontWeight="Bold" Foreground="White"
                   TextAlignment="Center"/>
        <Grid Grid.Row="1" ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#214E83" BorderBrush="#76B9F3"
                  BorderThickness="2" CornerRadius="12" Padding="18">
            <StackPanel VerticalAlignment="Center" Spacing="12">
              <TextBlock Text="INDIVIDUAL SESSIONS" Foreground="White"
                         FontSize="23" FontWeight="Bold" TextAlignment="Center"/>
              <TextBlock x:Name="LevelZeroSessionCountText" Text="LEVEL 0: 0 recorded sessions"
                         Foreground="White" FontSize="23" FontWeight="Bold"
                         TextAlignment="Center"/>
              <TextBlock x:Name="LevelZeroSessionHistoryText"
                         Foreground="#E2E8F0" FontSize="19" TextWrapping="Wrap"
                         TextAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#214E83" BorderBrush="#76B9F3"
                  BorderThickness="2" CornerRadius="12" Padding="18">
            <StackPanel VerticalAlignment="Center" Spacing="12">
              <TextBlock Text="SESSION COMPARISONS" Foreground="White"
                         FontSize="23" FontWeight="Bold" TextAlignment="Center"/>
              <TextBlock x:Name="LevelZeroSessionComparisonText"
                         Foreground="#E2E8F0" FontSize="16" TextWrapping="Wrap"
                         TextAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#182B43" BorderBrush="#566D8A"
                  BorderThickness="2" CornerRadius="12" Padding="18">
            <StackPanel VerticalAlignment="Center" Spacing="12">
              <TextBlock Text="SESSION CONDITIONS" Foreground="White"
                         FontSize="23" FontWeight="Bold" TextAlignment="Center"/>
              <TextBlock Text="Not recorded" Foreground="#E2E8F0"
                         FontSize="23" FontWeight="Bold" TextAlignment="Center"/>
              <TextBlock Text="Optional positioning, lighting, screen angle, glasses, time of day, effort, comfort and fatigue ratings. User-controlled, never required."
                         Foreground="#E2E8F0" FontSize="17" TextWrapping="Wrap"
                         TextAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#182B43" BorderBrush="#566D8A"
                  BorderThickness="2" CornerRadius="12" Padding="18">
            <StackPanel VerticalAlignment="Center" Spacing="12">
              <TextBlock Text="THERAPIST EXPORT" Foreground="White"
                         FontSize="23" FontWeight="Bold" TextAlignment="Center"/>
              <Button x:Name="TherapistExportButton" Content="EXPORT .TXT REPORT"
                      Style="{StaticResource PrimaryGazeButton}" Click="OnExportTherapistReport"
                      FontSize="22" FontWeight="Bold" MinHeight="80"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              <TextBlock x:Name="TherapistExportStatusText"
                         Text="Export a readable report to your Downloads folder."
                         Foreground="#E2E8F0" FontSize="18"
                         TextAlignment="Center" TextWrapping="Wrap"
                         MaxLines="3"/>
              <TextBlock Text="Text only. Includes actual progress, trends, settings, both 7×5 maps, and clearly marked unavailable metrics. Saved only when selected."
                         Foreground="#E2E8F0" FontSize="17" TextWrapping="Wrap"
                         TextAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <!-- Noninteractive success popup; it never blocks gaze Back or tabs. -->
      <Border x:Name="TherapistExportConfirmation"
              Grid.Row="2" Canvas.ZIndex="30"
              Visibility="Collapsed" IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="710" Margin="24"
              Background="#173B52" BorderBrush="#6ED6AA"
              BorderThickness="3" CornerRadius="16" Padding="32,26">
        <StackPanel Spacing="13">
          <TextBlock Text="REPORT SAVED" FontSize="34"
                     FontWeight="Bold" Foreground="#B6F7D6"
                     TextAlignment="Center"/>
          <TextBlock Text="Your therapist report has been saved to your Downloads folder."
                     Foreground="White" FontSize="25"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock x:Name="TherapistExportConfirmationFilename"
                     Foreground="#D5EAFE" FontSize="17"
                     TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"/>
          <TextBlock Text="This message will close automatically."
                     Foreground="#D5EAFE" FontSize="17" TextAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Lesson selection and replay === -->
    <Grid x:Name="LevelsPanel" Background="#101827" Padding="24"
          Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="CHOOSE A LEVEL" FontSize="32"
                 FontWeight="Bold" Foreground="White" TextAlignment="Center"
                 Margin="0,0,0,12"/>
      <!-- Two columns by four rows: Level 0 through Level 6 and Back. -->
      <Grid Grid.Row="1" ColumnSpacing="18" RowSpacing="16"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Style="{StaticResource PrimaryGazeButton}" x:Name="LevelZeroReplayButton"
                Grid.Row="0" Grid.Column="0" Content="LEVEL 0"
                Click="OnLevelZeroReplay" MinHeight="90" FontSize="29" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
        <Button Style="{StaticResource PrimaryGazeButton}" x:Name="LevelOneButton"
                Grid.Row="0" Grid.Column="1" Content="LEVEL 1"
                Click="OnLevelOne" MinHeight="90" FontSize="29" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
        <Button Style="{StaticResource PendingLevelButton}" x:Name="LevelTwoButton"
                Grid.Row="1" Grid.Column="0" Content="LEVEL 2"
                Click="OnPlaceholderLevel" MinHeight="90" FontSize="29" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
        <Button Style="{StaticResource PendingLevelButton}" x:Name="LevelThreeButton"
                Grid.Row="1" Grid.Column="1" Content="LEVEL 3"
                Click="OnPlaceholderLevel" MinHeight="90" FontSize="29" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
        <Button Style="{StaticResource PendingLevelButton}" x:Name="LevelFourButton"
                Grid.Row="2" Grid.Column="0" Content="LEVEL 4"
                Click="OnPlaceholderLevel" MinHeight="90" FontSize="29" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
        <Button Style="{StaticResource PendingLevelButton}" x:Name="LevelFiveButton"
                Grid.Row="2" Grid.Column="1" Content="LEVEL 5"
                Click="OnPlaceholderLevel" MinHeight="90" FontSize="29" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
        <Button Style="{StaticResource PendingLevelButton}" x:Name="LevelSixButton"
                Grid.Row="3" Grid.Column="0" Content="LEVEL 6"
                Click="OnPlaceholderLevel" MinHeight="90" FontSize="29" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
        <Button Style="{StaticResource DangerGazeButton}" x:Name="LevelsBackButton"
                Grid.Row="3" Grid.Column="1" Content="BACK TO MENU"
                Click="OnBackToMenu" MinHeight="90" FontSize="25" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
      </Grid>
      <TextBlock x:Name="LevelsNoticeText" Grid.Row="2" Margin="0,10,0,0"
                 FontSize="18" TextAlignment="Center"
                 Foreground="#FBBF24" TextWrapping="Wrap"/>
    </Grid>

    <!-- Target practice === -->
    <Grid x:Name="LessonPanel" Background="Black" Visibility="Collapsed">
      <!-- One visible target at a time, positioned on the black canvas. -->
      <Canvas x:Name="TrainingCanvas" Background="Black" SizeChanged="OnCanvasSized"
              PointerMoved="OnPointerMoved" PointerEntered="OnPointerMoved"
               PointerPressed="OnTrainingCanvasPointerPressed">
        <Ellipse x:Name="TargetRing" Width="116" Height="116"
                 Stroke="#FBBF24" StrokeThickness="8" Fill="#344358"
                 Visibility="Collapsed" IsHitTestVisible="False"/>
        <Ellipse x:Name="TargetBullseye" Width="14" Height="14"
                 Fill="#FFFFFF" Stroke="#0D253B" StrokeThickness="2"
                 Visibility="Collapsed" IsHitTestVisible="False"/>
      </Canvas>
      <!-- Remaining targets: visual only, never a gaze or mouse action. -->
      <Border x:Name="TargetCountdown" Width="90" Height="34"
              HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="20,0,0,16"
              Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock x:Name="TargetCountdownText" Text="35 remaining"
                   Foreground="White" FontSize="12" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <!-- Intro uses the same bright, playful style as Level 1 completion. -->
      <Grid x:Name="LessonIntroOverlay" Background="Black"
            Visibility="Collapsed" IsHitTestVisible="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="22" Margin="28">
          <TextBlock Text="Ready, Set, Look!" Foreground="#FFD84D"
                     FontFamily="Comic Sans MS" FontWeight="Bold" FontSize="72"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="Look directly at the center of each target and hold your gaze until it fills. Find all 35!"
                     Foreground="#69E6FF" FontFamily="Comic Sans MS"
                     FontWeight="Bold" FontSize="42"
                     TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
      <!-- Celebration stays on the same black lesson screen for three seconds. -->
      <Grid x:Name="CompletionOverlay" Background="Black"
            Visibility="Collapsed" IsHitTestVisible="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="22" Margin="28">
          <TextBlock Text="Great Job!" Foreground="#FFD84D"
                     FontFamily="Comic Sans MS" FontWeight="Bold" FontSize="76"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="On to the bonus round!" Foreground="#69E6FF"
                     FontFamily="Comic Sans MS" FontWeight="Bold" FontSize="48"
                     TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
      <Button Style="{StaticResource DangerGazeButton}" x:Name="LessonBackButton" Content="BACK"
              Click="OnBackToLevels" MinHeight="86" MinWidth="155"
              Padding="16,12" FontSize="22" FontWeight="Bold"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="20,16,0,0"/>
    </Grid>

    <!-- The question or its answer occupies the top half of the screen. -->
    <!-- True/false bonus round === -->
    <Grid x:Name="BonusPanel" Background="Black" Visibility="Collapsed" Padding="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Padding="14" Margin="0,76,0,0" VerticalAlignment="Stretch">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
          <StackPanel Width="1050" Spacing="22">
            <TextBlock x:Name="BonusProgressText" Foreground="#FFD84D"
                       FontFamily="Comic Sans MS" FontSize="48" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="BonusFactText" Foreground="#69E6FF"
                       FontFamily="Comic Sans MS" FontSize="42" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Viewbox>
      </Grid>
      <Grid x:Name="BonusChoicesPanel" Grid.Row="1" ColumnSpacing="22"
            Margin="10,8,10,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BonusTrueButton" Grid.Column="0" Content="TRUE"
                Style="{StaticResource PrimaryGazeButton}" Click="OnBonusTrue"
                FontSize="48" FontWeight="Bold" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <Button x:Name="BonusFalseButton" Grid.Column="1" Content="FALSE"
                Style="{StaticResource PrimaryGazeButton}" Click="OnBonusFalse"
                FontSize="48" FontWeight="Bold" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" HorizontalContentAlignment="Center"/>
      </Grid>
      <!-- Final score and encouragement remain visible until narration ends. -->
      <Grid x:Name="BonusFinalPanel" Grid.Row="1" Visibility="Collapsed">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20,8">
          <StackPanel Width="1050" Spacing="18" VerticalAlignment="Center">
            <TextBlock x:Name="BonusFinalText" Foreground="#FFD84D"
                       FontFamily="Comic Sans MS" FontSize="54" FontWeight="Bold"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="BonusFinalEncouragementText" Foreground="#69E6FF"
                       FontFamily="Comic Sans MS" FontSize="42" FontWeight="Bold"
                       TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Viewbox>
      </Grid>
      <Button Style="{StaticResource DangerGazeButton}" x:Name="BonusBackButton"
              Content="BACK" Click="OnBackToLevels" MinHeight="86" MinWidth="155"
              Padding="16,12" FontSize="22" FontWeight="Bold"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="20,16,0,0"/>
    </Grid>

    <!-- Automatic bonus intro; no answer buttons are available until it ends. -->
    <Grid x:Name="BonusIntroOverlay" Background="Black"
          Visibility="Collapsed" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="22" Margin="28">
        <TextBlock Text="Trivia Time!" Foreground="#FFD84D"
                   FontFamily="Comic Sans MS" FontWeight="Bold" FontSize="76"
                   TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="10 fun facts! Look at TRUE or FALSE to choose your answer. Try to look directly at the center of the button and keep your eyes steady until the button is selected."
                   Foreground="#69E6FF" FontFamily="Comic Sans MS"
                   FontWeight="Bold" FontSize="42"
                   TextAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="DisplaySettingsPanel" Background="#101827" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="20,16,20,8">
        <Button x:Name="SettingsExitButton" Style="{StaticResource DangerGazeButton}"
                Content="BACK" Click="OnCancelDisplay" MinHeight="76" MinWidth="130"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Margin="145,0,145,0" Spacing="8">
          <TextBlock Text="Display Size Adjustment" FontSize="30" FontWeight="Bold"
                     TextAlignment="Center" Foreground="White"/>
          <TextBlock Text="Adjust the blue bar until its width matches the center camera of your PCEye 5."
                     TextWrapping="Wrap" TextAlignment="Center" FontSize="21" Foreground="#E2E8F0"/>
          <TextBlock Text="Changes are saved automatically."
                     FontSize="17" TextAlignment="Center" Foreground="#CAD5E5"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="20,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*"/>
          <ColumnDefinition Width="4*"/>
          <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="ShorterButton" Grid.Column="0" Content="− SHORTER"
                Style="{StaticResource SecondaryGazeButton}" Click="OnReferenceShorter"
                MinHeight="100" FontSize="20" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                HorizontalContentAlignment="Center"/>
        <Border Grid.Column="1" Background="#1C3049" CornerRadius="12" Padding="8" VerticalAlignment="Center">
          <Viewbox Stretch="Uniform" HorizontalAlignment="Center">
            <Canvas Width="800" Height="430" IsHitTestVisible="False">
              <!-- The image retains its original aspect ratio. Its camera width
                   and demonstration bar share a common design-space scale. -->
              <Rectangle Canvas.Left="40" Canvas.Top="12" Width="720" Height="240"
                         RadiusX="12" RadiusY="12" Fill="#111C2A" Stroke="#9EB1C6" StrokeThickness="4"/>
              <Rectangle Canvas.Left="53" Canvas.Top="25" Width="694" Height="214" Fill="#20354F"/>
              <!-- Animated example on bottom edge of illustrated display. -->
              <Rectangle Canvas.Left="322" Canvas.Top="225" Width="156" Height="12"
                         Fill="#60BDFB" RadiusX="6" RadiusY="6" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                  <ScaleTransform x:Name="AnimatedExampleBarScale" ScaleX="1.8"/>
                </Rectangle.RenderTransform>
              </Rectangle>
              <Image Source="ms-appx:///Assets/PCEye5.png" Canvas.Left="20" Canvas.Top="200"
                     Width="760" Height="228" Stretch="Uniform"/>
              <!-- Pointer terminates at the central camera. -->
              <Line X1="400" Y1="366" X2="400" Y2="319" Stroke="#E4F1FF" StrokeThickness="3"/>
              <Polygon Points="392,331 400,317 408,331" Fill="#E4F1FF"/>
              <TextBlock Canvas.Left="240" Canvas.Top="370" Width="320"
                         Text="Center camera" FontSize="24" FontWeight="Bold"
                         TextAlignment="Center" Foreground="#E4F1FF"/>
            </Canvas>
          </Viewbox>
        </Border>
        <Button x:Name="LongerButton" Grid.Column="2" Content="+ LONGER"
                Style="{StaticResource PrimaryGazeButton}" Click="OnReferenceLonger"
                MinHeight="100" FontSize="20" FontWeight="Bold"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                HorizontalContentAlignment="Center"/>
      </Grid>
      <StackPanel Grid.Row="2" Spacing="8" IsHitTestVisible="False">
        <TextBlock x:Name="CalibrationStatusText" Text="Adjust the width."
                   TextAlignment="Center" TextWrapping="Wrap" FontSize="18" Foreground="#E2E8F0"/>
        <!-- This is the real reference bar; the illustration never changes it. -->
        <Rectangle x:Name="CalibrationReferenceBar" Height="32" Width="230"
                   HorizontalAlignment="Center" RadiusX="16" RadiusY="16"
                   Fill="#60BDFB" Stroke="#D5F2FF" StrokeThickness="2"/>
      </StackPanel>
    </Grid>

    <!-- Immersive startup branding. The scalable paths and type echo the
         approved Eye Gaze Trainer logo without relying on a bitmap asset. -->
    <Grid x:Name="StartupSplashPanel" Background="#050B14"
          Canvas.ZIndex="100" IsHitTestVisible="True">
      <Viewbox Stretch="Uniform" HorizontalAlignment="Center"
               VerticalAlignment="Center" Margin="60">
        <StackPanel Width="1100" HorizontalAlignment="Center">
          <Grid Width="620" Height="315" HorizontalAlignment="Center">
            <Path Data="M 30,200 C 176,32 435,-11 595,201 C 420,98 214,98 30,200"
                  Stretch="None">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#1877FC" Offset="0"/>
                  <GradientStop Color="#3DE8EE" Offset="1"/>
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Path Data="M 75,218 C 205,316 405,330 557,210 C 426,373 193,345 75,218"
                  Stretch="None">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#1676FA" Offset="0"/>
                  <GradientStop Color="#3CE7F2" Offset="1"/>
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Ellipse Width="235" Height="235" HorizontalAlignment="Center"
                     VerticalAlignment="Center" StrokeThickness="29">
              <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                  <GradientStop Color="#075796" Offset="0"/>
                  <GradientStop Color="#179BEF" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Stroke>
            </Ellipse>
            <Ellipse Width="62" Height="62" Fill="#21E8F1"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Canvas Width="185" Height="185" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <Path Data="M 25,63 L 25,35 Q 25,25 35,25 L 62,25"
                    Stroke="#28F4FF" StrokeThickness="10"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M 123,25 L 150,25 Q 160,25 160,35 L 160,63"
                    Stroke="#28F4FF" StrokeThickness="10"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M 25,122 L 25,150 Q 25,160 35,160 L 62,160"
                    Stroke="#28F4FF" StrokeThickness="10"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M 123,160 L 150,160 Q 160,160 160,150 L 160,122"
                    Stroke="#28F4FF" StrokeThickness="10"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                      Spacing="20" Margin="0,28,0,0">
            <TextBlock Text="Eye Gaze" Foreground="#F7FBFF"
                       FontSize="107" FontWeight="Bold"/>
            <TextBlock Text="Trainer" Foreground="#30E6ED"
                       FontSize="107" FontWeight="Bold"/>
          </StackPanel>
        </StackPanel>
      </Viewbox>
    </Grid>

    <!-- Acknowledged with a normal mouse click; shown only when no tracker is found. -->
    <!-- Temporary mouse fallback notice === -->
    <Grid x:Name="NoTrackerNoticePanel" Visibility="Collapsed" Canvas.ZIndex="110"
          Background="#E6091525" IsHitTestVisible="True">
      <Border Background="#182B43" BorderBrush="#76B9F3" BorderThickness="3"
              CornerRadius="16" Padding="32" MaxWidth="760"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
        <StackPanel Spacing="24">
          <TextBlock Text="NO EYE TRACKER DETECTED" FontSize="32" FontWeight="Bold"
                     Foreground="White" TextAlignment="Center"/>
          <TextBlock Text="Eye Gaze Trainer requires a Tobii PCEye 5 for eye-gaze control. No usable gaze input was received. The app will start in mouse mode. Eye-gaze diagnostics will not be collected."
                     FontSize="25" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
          <Button Content="CONTINUE WITH MOUSE" Click="OnDismissNoTrackerNotice"
                  Style="{StaticResource PrimaryGazeButton}" MinWidth="350" MinHeight="88"
                  FontSize="24" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Canvas x:Name="CursorOverlay" IsHitTestVisible="False"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Canvas.ZIndex="30">
      <Ellipse x:Name="PreviewDot" Width="44" Height="44" Fill="#34D399"
               Visibility="Collapsed" IsHitTestVisible="False"/>
      <!-- The two eyes are the cursor itself, not separately moving objects. -->
      <Canvas x:Name="LevelZeroEyeCursor" Width="112" Height="65"
              Visibility="Collapsed" IsHitTestVisible="False">
        <Ellipse Canvas.Left="2" Canvas.Top="4" Width="53" Height="53"
                 Fill="#EDF7FF" Stroke="#68BFE9" StrokeThickness="3"/>
        <Ellipse Canvas.Left="57" Canvas.Top="4" Width="53" Height="53"
                 Fill="#EDF7FF" Stroke="#68BFE9" StrokeThickness="3"/>
        <Ellipse Canvas.Left="22" Canvas.Top="21" Width="23" Height="23"
                 Fill="#235D8D"/>
        <Ellipse Canvas.Left="77" Canvas.Top="21" Width="23" Height="23"
                 Fill="#235D8D"/>
        <Ellipse Canvas.Left="29" Canvas.Top="27" Width="10" Height="10"
                 Fill="#0D1C2C"/>
        <Ellipse Canvas.Left="84" Canvas.Top="27" Width="10" Height="10"
                 Fill="#0D1C2C"/>
