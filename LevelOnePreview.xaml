<Page x:Class="EyeGazeApiViability.LevelOnePreview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#101827">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="28,22,28,12" Spacing="10">
      <TextBlock Text="LEVEL 1 — Discover movement" FontSize="30" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="HARDWARE-FREE DEVELOPER PREVIEW: Mouse position simulates gaze. The eye tracker is never opened."
                 TextWrapping="Wrap" FontSize="18" Foreground="#FCA5A5"/>
      <TextBlock x:Name="InstructionText"
                 Text="Move the mouse into the blue area. The green circle will follow automatically — no clicking."
                 FontSize="23" TextWrapping="Wrap" Foreground="#E2E8F0"/>
      <TextBlock x:Name="ProgressText" Text="Discover the moving circle" FontSize="18" Foreground="#93C5FD"/>
    </StackPanel>
    <Canvas Grid.Row="1" x:Name="TrainingCanvas" Margin="24" Background="#17253D"
            PointerMoved="OnPointerMoved" PointerEntered="OnPointerMoved" SizeChanged="OnCanvasSized">
      <Ellipse x:Name="TargetRing" Width="116" Height="116"
               Stroke="#FBBF24" StrokeThickness="8" Fill="#344358" Visibility="Collapsed"/>
      <Ellipse x:Name="PreviewDot" Width="44" Height="44" Fill="#34D399" Visibility="Collapsed"/>
    </Canvas>
    <Grid Grid.Row="2" Margin="28,10,28,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="No dwell • No clicks for targets • No automatic exit" FontSize="17"
                 Foreground="#CBD5E1" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button Grid.Column="1" Content="BACK TO DIAGNOSTICS (developer)"
              Click="OnBack" FontSize="18" Padding="16,12"/>
    </Grid>
  </Grid>
</Page>
