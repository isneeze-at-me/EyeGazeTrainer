<Page x:Class="EyeGazeApiViability.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Gaze-free handoff page. Keep this page in the exit route so the
       proven resource release -> navigation -> delayed exit stays intact. -->
  <Grid Background="#101827">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="18" Margin="28" MaxWidth="680">
      <ProgressRing IsActive="True" Width="56" Height="56"
                    Foreground="#34D399" HorizontalAlignment="Center"/>
      <TextBlock Text="Closing EyeGazeTrainer"
                 TextAlignment="Center" FontSize="32" FontWeight="SemiBold"
                 Foreground="#FFFFFF"/>
      <TextBlock Text="Returning to your computer"
                 TextAlignment="Center" FontSize="20" Foreground="#CBD5E1"/>
    </StackPanel>
  </Grid>
</Page>
